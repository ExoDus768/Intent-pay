# Keep this secret on the server only. Never commit a real JWT.
ONECLICK_JWT=replace_with_your_1click_jwt
# Optional comma-separated browser origins for production.
APP_ORIGIN=
PORT=3001

# Public WalletConnect project ID (create one at https://cloud.walletconnect.com/)
VITE_WALLETCONNECT_PROJECT_ID=
# Upstash Redis REST credentials for persistent invoices, merchant dashboard records, and webhook delivery.
# Keep the token server-side; never prefix it with VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
